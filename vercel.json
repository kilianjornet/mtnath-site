{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/trailrunning-tests", "destination": "https://app.mtnath.com", "permanent": true },
    { "source": "/trailrunning-tests/:path*", "destination": "https://app.mtnath.com", "permanent": true },
    { "source": "/wp-login.php", "destination": "https://app.mtnath.com", "permanent": true },
    { "source": "/wp-admin/:path*", "destination": "/", "permanent": true },
    { "source": "/privacy-policy", "destination": "/legal/#privacy", "permanent": true },
    { "source": "/feed/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/instructions/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
